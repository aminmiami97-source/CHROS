{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile authenticated with Google OAuth in CHROS",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "email"]
    },
    "SearchHistoryItem": {
      "title": "SearchHistoryItem",
      "description": "Synced search query history record for an authenticated user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "query": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "maxLength": 64 },
        "resultsCount": { "type": "number" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "userId", "query", "category", "timestamp"]
    },
    "SavedResult": {
      "title": "SavedResult",
      "description": "Bookmarked search result for fast research recall",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 300 },
        "url": { "type": "string", "maxLength": 1000 },
        "domain": { "type": "string", "maxLength": 128 },
        "snippet": { "type": "string", "maxLength": 1000 },
        "query": { "type": "string", "maxLength": 500 },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "userId", "title", "url", "domain", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile documents"
    },
    "/users/{userId}/history/{historyId}": {
      "schema": { "$ref": "#/entities/SearchHistoryItem" },
      "description": "User's persistent search history records"
    },
    "/users/{userId}/saved/{savedId}": {
      "schema": { "$ref": "#/entities/SavedResult" },
      "description": "User's bookmarked search results"
    }
  }
}
